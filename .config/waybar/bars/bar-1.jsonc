// -*- mode jsonc -*-
{
	"include": [
		"~/.config/waybar/modules/clock.jsonc",
		"~/.config/waybar/modules/custom-power.jsonc",
		"~/.config/waybar/modules/network.jsonc",
		"~/.config/waybar/modules/wireplumber.jsonc"
	],
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
	"clock"
    ],
    "modules-right": [
        "tray",
        "wireplumber",
        "network",
        "custom/power"
    ],
    "wlr/taskbar": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "fullscreen",
        "icon-theme": "WhiteSur",
        "icon-size": 25,
        "tooltip-format": "{title}"
    },
    //  Modules configuration
    "hyprland/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format": "{name}: {icon}",
         "format-icons": {
             "1": "",
             "urgent": "",
             "focused": "",
             "default": ""
         },
    "persistent-workspaces": {
            "1": [],
        }
     }
}
