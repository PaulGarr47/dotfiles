[
    {
        "name": "bar-1",
        "include": "~/.config/waybar/bars/bar-1.jsonc",
        "layer": "top", // Waybar at top layer
        "position": "top", // Waybar position (top|bottom|left|right)
        "height": 74, // Waybar height (to be removed for auto height)
        "spacing": -2, // 4 px
        "output": ["DP-2", "DP-3"], //monitor output names change between these two values
        "mode": "dock"
    },
    {
        "name": "bar-2",
        "include": "~/.config/waybar/bars/bar-2.jsonc",
        "layer": "top", // Waybar at top layer
        "position": "top", // Waybar position (top|bottom|left|right)
        "height": 74, // Waybar height (to be removed for auto height)
        "spacing": -2, // 4 px
        "output": ["HDMI-A-2","HDMI-A-1"], //monitor output names change between these two values
        "mode": "dock"
    }
]
