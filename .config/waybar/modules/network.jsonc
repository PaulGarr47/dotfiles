{
	"network": {
		"format-wifi" : "{icon}",
		"format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
		"format-ethernet": "󰀂 {ifname}",
		"format-linked" : "󱛇",
		"format-disconnected" : "󰖪",
		"tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
